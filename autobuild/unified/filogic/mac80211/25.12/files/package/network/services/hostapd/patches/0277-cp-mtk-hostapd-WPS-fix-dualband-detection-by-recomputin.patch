From f3f2aae69ffef9bf108fd2f37c0c105340941d5f Mon Sep 17 00:00:00 2001
From: Michael-CY Lee <michael-cy.lee@mediatek.com>
Date: Wed, 10 Jun 2026 17:23:22 +0800
Subject: [PATCH] mtk: hostapd: WPS: fix dualband detection by recomputing at
 PBC activation time

The dualband flag is set once at BSS init time. It is unreliable
becasue interface_count() may return 1 if the other iface(s) is not
yet registered, and dynamically added BSSes never update the flag on
the peer BSS.

Fix this by recomputing dualband in wps_button_pushed() just before
activating PBC, when all interfaces are guaranteed to be up. Add
wps_registrar_set_dualband() as a proper public setter to avoid
accessing struct wps_registrar internals across module boundaries.

Signed-off-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
---
 src/ap/wps_hostapd.c    | 16 ++++++++++++++++
 src/wps/wps.h           |  1 +
 src/wps/wps_registrar.c |  6 ++++++
 3 files changed, 23 insertions(+)

diff --git a/src/ap/wps_hostapd.c b/src/ap/wps_hostapd.c
index c9f1b0418..ad6010e7c 100644
--- a/src/ap/wps_hostapd.c
+++ b/src/ap/wps_hostapd.c
@@ -1040,6 +1040,20 @@ static int interface_count(struct hostapd_iface *iface)
 }
 
 
+static void hostapd_wps_update_dualband(struct hostapd_data *hapd)
+{
+	int dualband = interface_count(hapd->iface) > 1;
+
+	if (!dualband && hapd->wps &&
+	    (hapd->wps->dev.rf_bands & (WPS_RF_50GHZ | WPS_RF_24GHZ)) ==
+	    (WPS_RF_50GHZ | WPS_RF_24GHZ))
+		dualband = 1;
+
+	if (hapd->wps && hapd->wps->registrar)
+		wps_registrar_set_dualband(hapd->wps->registrar, dualband);
+}
+
+
 static int hostapd_wps_set_vendor_ext(struct hostapd_data *hapd,
 				      struct wps_context *wps)
 {
@@ -1628,6 +1642,7 @@ static int wps_button_pushed(struct hostapd_data *hapd, void *ctx)
 	if (hapd->wps == NULL)
 		return 0;
 
+	hostapd_wps_update_dualband(hapd);
 	ret = wps_registrar_button_pushed(hapd->wps->registrar,
 					  data->p2p_dev_addr);
 	if (ret)
@@ -1643,6 +1658,7 @@ static int wps_button_pushed(struct hostapd_data *hapd, void *ctx)
 				continue;
 
 			/* TODO: error recovery if one of the link returns failure */
+			hostapd_wps_update_dualband(h);
 			ret = wps_registrar_button_pushed(h->wps->registrar,
 							  data->p2p_dev_addr);
 			if (ret)
diff --git a/src/wps/wps.h b/src/wps/wps.h
index b99ae9499..881ded561 100644
--- a/src/wps/wps.h
+++ b/src/wps/wps.h
@@ -870,6 +870,7 @@ void wps_registrar_probe_req_rx(struct wps_registrar *reg, const u8 *addr,
 				const struct wpabuf *wps_data,
 				int p2p_wildcard);
 int wps_registrar_update_ie(struct wps_registrar *reg);
+void wps_registrar_set_dualband(struct wps_registrar *reg, int dualband);
 int wps_registrar_get_info(struct wps_registrar *reg, const u8 *addr,
 			   char *buf, size_t buflen);
 int wps_registrar_config_ap(struct wps_registrar *reg,
diff --git a/src/wps/wps_registrar.c b/src/wps/wps_registrar.c
index f49784f95..0d9d88387 100644
--- a/src/wps/wps_registrar.c
+++ b/src/wps/wps_registrar.c
@@ -3462,6 +3462,12 @@ int wps_registrar_update_ie(struct wps_registrar *reg)
 }
 
 
+void wps_registrar_set_dualband(struct wps_registrar *reg, int dualband)
+{
+	reg->dualband = dualband;
+}
+
+
 static void wps_registrar_set_selected_timeout(void *eloop_ctx,
 					       void *timeout_ctx)
 {
