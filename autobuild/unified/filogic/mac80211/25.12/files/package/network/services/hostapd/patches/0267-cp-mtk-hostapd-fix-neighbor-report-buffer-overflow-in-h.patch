From 927610fb674f2d2854e061362bbc48ea3c1d1b59 Mon Sep 17 00:00:00 2001
From: Howard Hsu <howard-yh.hsu@mediatek.com>
Date: Thu, 23 Jul 2026 15:20:41 +0800
Subject: [PATCH] mtk: hostapd: fix neighbor report buffer overflow in
 hostapd_neighbor_insert_buffer()

fixup! mtk: hostapd: Add neighbor report and BSS Termination for MBO certification

hostapd_neighbor_insert_buffer() never checked buflen, overflowing the
1000-byte stack buffer in ctrl_iface_ap.c and the heap buffer in wnm_ap.c
that wrongly assumed a 13-byte body. It also computed "nre->len - 13"
without checking nre->len >= 13, underflowing into get_ie().

Add hostapd_neighbor_buffer_len() so callers allocate the exact size, and
stop writing once buflen is exhausted. wnm_ap.c and gas_serv.c now size
via this helper instead of hostapd_neighbor_count() times a guessed
per-entry size; the now-unused hostapd_neighbor_count() is removed.

Signed-off-by: Howard Hsu <howard-yh.hsu@mediatek.com>
---
 src/ap/gas_serv.c    | 20 ++++++------
 src/ap/neighbor_db.c | 72 ++++++++++++++++++++++++++++++--------------
 src/ap/neighbor_db.h | 17 ++++++++++-
 src/ap/wnm_ap.c      | 31 +++++++++++--------
 4 files changed, 95 insertions(+), 45 deletions(-)

diff --git a/src/ap/gas_serv.c b/src/ap/gas_serv.c
index 5ccb47202..da5898350 100644
--- a/src/ap/gas_serv.c
+++ b/src/ap/gas_serv.c
@@ -367,16 +367,16 @@ static void anqp_add_neighbor_report(struct hostapd_data *hapd,
 {
 	struct hostapd_neighbor_entry *nr;
 	u8 *len_pos = gas_anqp_add_element(buf, ANQP_NEIGHBOR_REPORT);
-	if (dl_list_empty(&hapd->nr_db)) {
-		wpabuf_put_le16(buf, 0);
-	}
-	else {
-		dl_list_for_each(nr, &hapd->nr_db, struct hostapd_neighbor_entry, list ) {
-			wpabuf_put_u8(buf, WLAN_EID_NEIGHBOR_REPORT);
-			wpabuf_put_u8(buf, wpabuf_len(nr->nr));
-			wpabuf_put_buf(buf, nr->nr);
-		}
+
+	dl_list_for_each(nr, &hapd->nr_db, struct hostapd_neighbor_entry, list) {
+		if (!nr->nr)
+			continue;
+
+		wpabuf_put_u8(buf, WLAN_EID_NEIGHBOR_REPORT);
+		wpabuf_put_u8(buf, wpabuf_len(nr->nr));
+		wpabuf_put_buf(buf, nr->nr);
 	}
+
 	gas_anqp_set_element_len(buf, len_pos);
 }
 
@@ -769,7 +769,7 @@ gas_serv_build_gas_resp_payload(struct hostapd_data *hapd,
 	if (request & (ANQP_REQ_NAI_REALM | ANQP_REQ_NAI_HOME_REALM))
 		len += 1000;
 	if (request & ANQP_REQ_NEIGHBOR_REPORT)
-		len += (40 * hostapd_neighbor_count(hapd));
+		len += hostapd_neighbor_buffer_len(hapd);
 #ifdef CONFIG_FILS
 	if (request & ANQP_FILS_REALM_INFO)
 		len += 2 * dl_list_len(&hapd->conf->fils_realms);
diff --git a/src/ap/neighbor_db.c b/src/ap/neighbor_db.c
index 9b8c463f5..96e026587 100644
--- a/src/ap/neighbor_db.c
+++ b/src/ap/neighbor_db.c
@@ -89,16 +89,29 @@ int hostapd_neighbor_show(struct hostapd_data *hapd, char *buf, size_t buflen)
 }
 
 
-int hostapd_neighbor_count(struct hostapd_data *hapd)
+static bool hostapd_neighbor_should_append_pref_subelem(const struct wpabuf *nr)
+{
+	return get_ie(wpabuf_head_u8(nr) + NR_FIXED_FIELDS_LEN,
+		      wpabuf_len(nr) - NR_FIXED_FIELDS_LEN,
+		      WNM_NEIGHBOR_BSS_TRANSITION_CANDIDATE) == NULL;
+}
+
+
+size_t hostapd_neighbor_buffer_len(struct hostapd_data *hapd)
 {
 	struct hostapd_neighbor_entry *nr;
-	int count = 0;
+	size_t len = 0;
 
-	dl_list_for_each(nr, &hapd->nr_db, struct hostapd_neighbor_entry,
-			 list) {
-		count++;
+	dl_list_for_each(nr, &hapd->nr_db, struct hostapd_neighbor_entry, list) {
+		if (!nr->nr)
+			continue;
+
+		len += 2 + wpabuf_len(nr->nr);
+		len += hostapd_neighbor_should_append_pref_subelem(nr->nr) ?
+			NR_PREF_SUBELEM_LEN : 0;
 	}
-	return count;
+
+	return len;
 }
 
 
@@ -107,25 +120,30 @@ int hostapd_neighbor_insert_buffer(struct hostapd_data *hapd, char *buf,
 {
 	struct hostapd_neighbor_entry *nr;
 	char *pos = buf;
+	char *end = buf + buflen;
 
-	dl_list_for_each(nr, &hapd->nr_db, struct hostapd_neighbor_entry,
-			 list) {
-		struct neighbor_report_element *nre;
-		struct element *preference_subelem;
+	dl_list_for_each(nr, &hapd->nr_db, struct hostapd_neighbor_entry, list) {
+		bool append_pref_subelem;
+		size_t vlen, nre_len;
+
+		if (!nr->nr)
+			continue;
+
+		append_pref_subelem =
+			hostapd_neighbor_should_append_pref_subelem(nr->nr);
+		vlen = wpabuf_len(nr->nr);
+		nre_len = 1 + 1 + vlen +
+			(append_pref_subelem ? NR_PREF_SUBELEM_LEN : 0);
+
+		if ((size_t) (end - pos) < nre_len)
+			break;
 
-		nre = (struct neighbor_report_element *)pos;
-		/* For neighbor report IE, we only need bssid and nr*/
 		*pos++ = WLAN_EID_NEIGHBOR_REPORT;
-		*pos++ = wpabuf_len(nr->nr);
-		os_memcpy(pos, wpabuf_head(nr->nr), wpabuf_len(nr->nr));
-		pos += wpabuf_len(nr->nr);
-
-		preference_subelem = (struct element *)
-			get_ie(nre->variable,
-			       nre->len - (6 + 4 + 1 + 1 + 1),
-			       WNM_NEIGHBOR_BSS_TRANSITION_CANDIDATE);
-		if (!preference_subelem) {
-			nre->len += 3;
+		*pos++ = nre_len - 2;
+		os_memcpy(pos, wpabuf_head(nr->nr), vlen);
+		pos += vlen;
+
+		if (append_pref_subelem) {
 			*pos++ = WNM_NEIGHBOR_BSS_TRANSITION_CANDIDATE;
 			*pos++ = 1;
 			*pos++ = 0xff;
@@ -176,6 +194,16 @@ int hostapd_neighbor_set(struct hostapd_data *hapd, const u8 *bssid,
 {
 	struct hostapd_neighbor_entry *entry;
 
+	if (!nr || wpabuf_len(nr) < NR_FIXED_FIELDS_LEN ||
+	    wpabuf_len(nr) > NR_MAX_FIELDS_LEN) {
+		wpa_printf(MSG_ERROR,
+			   "Neighbor Report: malformed entry for " MACSTR
+			   " (len=%zu, expected %d..%d)",
+			   MAC2STR(bssid), nr ? wpabuf_len(nr) : 0,
+			   NR_FIXED_FIELDS_LEN, NR_MAX_FIELDS_LEN);
+		return -1;
+	}
+
 	entry = hostapd_neighbor_get(hapd, bssid, ssid);
 	if (!entry)
 		entry = hostapd_neighbor_add(hapd);
diff --git a/src/ap/neighbor_db.h b/src/ap/neighbor_db.h
index a1991b6ac..3726184e1 100644
--- a/src/ap/neighbor_db.h
+++ b/src/ap/neighbor_db.h
@@ -10,6 +10,21 @@
 #ifndef NEIGHBOR_DB_H
 #define NEIGHBOR_DB_H
 
+/*
+ * Fixed fields of a Neighbor Report element body: BSSID + BSSID Information +
+ * Operating Class + Channel Number + PHY Type.
+ */
+#define NR_FIXED_FIELDS_LEN	(6 + 4 + 1 + 1 + 1)
+
+/* BSS Transition Candidate Preference subelement: ID + Length + 1-octet body. */
+#define NR_PREF_SUBELEM_LEN	3
+
+/*
+ * The element Length field is one octet and has to cover an appended
+ * preference subelement as well.
+ */
+#define NR_MAX_FIELDS_LEN	(255 - NR_PREF_SUBELEM_LEN)
+
 struct hostapd_neighbor_entry *
 hostapd_neighbor_get(struct hostapd_data *hapd, const u8 *bssid,
 		     const struct wpa_ssid_value *ssid);
@@ -25,7 +40,7 @@ int hostapd_neighbor_remove(struct hostapd_data *hapd, const u8 *bssid,
 			    const struct wpa_ssid_value *ssid);
 void hostapd_free_neighbor_db(struct hostapd_data *hapd);
 
-int hostapd_neighbor_count(struct hostapd_data *hapd);
+size_t hostapd_neighbor_buffer_len(struct hostapd_data *hapd);
 int hostapd_neighbor_insert_buffer(struct hostapd_data *hapd, char *buf,
         size_t buflen);
 void hostapd_neighbor_set_own_report_pref(struct hostapd_data *hapd, u8 *nei_buf,
diff --git a/src/ap/wnm_ap.c b/src/ap/wnm_ap.c
index 99a36ac02..e56a8cd4e 100644
--- a/src/ap/wnm_ap.c
+++ b/src/ap/wnm_ap.c
@@ -391,19 +391,24 @@ static int ieee802_11_send_bss_trans_mgmt_request(struct hostapd_data *hapd,
 	u8 *pos;
 	int res;
 
-	int nr_num = hostapd_neighbor_count(hapd);
-	int nr_size = ETH_ALEN + 4 + 1 + 1 + 1 + 5;
-	int total_nr_size = nr_num * nr_size;
-	u8 *nr_data = os_malloc(total_nr_size);
+	size_t total_nr_size = hostapd_neighbor_buffer_len(hapd);
 	int nr_data_len = 0;
-	if(nr_data == NULL) {
-		wpa_printf (MSG_ERROR, "Failed to allocate memory");
-	} else {
-	    nr_data_len = hostapd_neighbor_insert_buffer(hapd, nr_data, total_nr_size);
+	u8 *nr_data = NULL;
+
+	if (total_nr_size) {
+		nr_data = os_malloc(total_nr_size);
+		if (nr_data == NULL) {
+			wpa_printf(MSG_ERROR,
+				   "WNM: Failed to allocate memory for neighbor report");
+			return -1;
+		}
+		nr_data_len = hostapd_neighbor_insert_buffer(hapd, nr_data, total_nr_size);
 	}
+
 	mgmt = os_zalloc(sizeof(*mgmt) + nr_data_len);
 	if (mgmt == NULL) {
-		wpa_printf (MSG_ERROR, "Failed to allocate memory for mgmt frame");
+		wpa_printf(MSG_ERROR, "WNM: Failed to allocate memory for BTM request");
+		os_free(nr_data);
 		return -1;
 	}
 
@@ -418,14 +423,15 @@ static int ieee802_11_send_bss_trans_mgmt_request(struct hostapd_data *hapd,
 	mgmt->u.action.u.bss_tm_req.action = WNM_BSS_TRANS_MGMT_REQ;
 	mgmt->u.action.u.bss_tm_req.dialog_token = dialog_token;
 	mgmt->u.action.u.bss_tm_req.req_mode = 0;
-	if(nr_num) {
-		mgmt->u.action.u.bss_tm_req.req_mode |= WNM_BSS_TM_REQ_PREF_CAND_LIST_INCLUDED;
+	if (nr_data_len) {
+		mgmt->u.action.u.bss_tm_req.req_mode |=
+			WNM_BSS_TM_REQ_PREF_CAND_LIST_INCLUDED;
 	}
 	mgmt->u.action.u.bss_tm_req.disassoc_timer = host_to_le16(0);
 	mgmt->u.action.u.bss_tm_req.validity_interval = 1;
 	pos = mgmt->u.action.u.bss_tm_req.variable;
 
-	if(nr_num) {
+	if (nr_data_len) {
 		os_memcpy(pos, nr_data, nr_data_len);
 		pos += nr_data_len;
 	}
@@ -443,6 +449,7 @@ static int ieee802_11_send_bss_trans_mgmt_request(struct hostapd_data *hapd,
 	res = hostapd_drv_send_action(hapd, hapd->iface->freq, 0,
 				      mgmt->da, &mgmt->u.action.category, len);
 	os_free(mgmt);
+	os_free(nr_data);
 	return res;
 }
 
-- 
2.45.2

