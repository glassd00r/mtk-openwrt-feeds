From 615f9fa0f2fd488e207e1b040b06f18d209263f1 Mon Sep 17 00:00:00 2001
From: Howard Hsu <howard-yh.hsu@mediatek.com>
Date: Mon, 27 Jul 2026 17:09:08 +0800
Subject: [PATCH] mtk: hostapd: fix out-of-bounds access in SCS Request
 handling

fixup! mtk: hostapd: Add Triggered Uplink Access Optimization support

hostapd_handle_scs_req() wrote to scs_status_list[index] without
bounding index, so a peer sending more than SCS_MAX_CFG_CNT SCS
Descriptor elements overflowed the on-stack array. Also, datalen may
be zero after for_each_element(), so verify that each SCS Descriptor
element carries SCSID and Request Type, and that a QoS Characteristics
element is long enough for its mandatory fields before parsing them.

Signed-off-by: Howard Hsu <howard-yh.hsu@mediatek.com>
---
 src/ap/scs.c         | 30 ++++++++++++++++++------------
 src/drivers/driver.h | 10 ++++++++--
 2 files changed, 26 insertions(+), 14 deletions(-)

diff --git a/src/ap/scs.c b/src/ap/scs.c
index ee26e869c..3fd6aa3fb 100644
--- a/src/ap/scs.c
+++ b/src/ap/scs.c
@@ -299,22 +299,21 @@ static int hostapd_find_available_scs_session(struct sta_info *sta)
 static bool hostapd_parse_qos_char_element(const struct element *elem,
 					   struct hostapd_scs_desc_info *info)
 {
-	u8 id_extension = elem->data[0];
 	u32 control_info;
 
-	info->qos_ie_len = elem->datalen + 2;
-
-	if (id_extension != WLAN_EID_EXT_QOS_CHARACTERISTICS ||
-	    info->qos_ie_len > sizeof(info->qos_ie))
+	if (elem->datalen < EID_EXT_QOS_CHAR_MIN_SIZE ||
+	    elem->datalen > EID_EXT_QOS_CHAR_MAX_SIZE ||
+	    elem->data[0] != WLAN_EID_EXT_QOS_CHARACTERISTICS)
 		return false;
 
 	control_info = WPA_GET_LE32(&elem->data[1]);
-	info->dir = control_info & 0x3;
 
 	/* Only support Uplink direction SCS request now. */
-	if (info->dir != SCS_DIRECTION_UP)
+	if ((control_info & 0x3) != SCS_DIRECTION_UP)
 		return false;
 
+	info->dir = SCS_DIRECTION_UP;
+	info->qos_ie_len = elem->datalen + 2;
 	os_memcpy(info->qos_ie, elem, info->qos_ie_len);
 
 	return true;
@@ -351,8 +350,8 @@ static u16 hostapd_process_scs_descriptor(struct hostapd_data *hapd,
 		for_each_element(elem, payload + 2, scs_desc_len - 2) {
 			switch (elem->id) {
 			case WLAN_EID_EXTENSION:
-				qos_char_elem_avail =
-					hostapd_parse_qos_char_element(elem, info);
+				if (hostapd_parse_qos_char_element(elem, info))
+					qos_char_elem_avail = true;
 				break;
 			default:
 				/* The rest elements would be ignored now. */
@@ -454,12 +453,19 @@ static void hostapd_handle_scs_req(struct hostapd_data *hapd,
 	len = end - pos;
 
 	for_each_element(elem, pos, len) {
-		if (elem->id != WLAN_EID_SCS_DESCRIPTOR) {
-			wpa_printf(MSG_ERROR, "%s: no scs elem %d in scs req frame!\n",
-				   __func__, WLAN_EID_SCS_DESCRIPTOR);
+		if (index >= SCS_MAX_CFG_CNT) {
+			wpa_printf(MSG_ERROR, "%s: too many SCS descriptors\n",
+				   __func__);
+			break;
+		}
+
+		if (elem->datalen < 2 || elem->id != WLAN_EID_SCS_DESCRIPTOR) {
+			wpa_printf(MSG_ERROR, "%s: invalid SCS descriptor elem\n",
+				   __func__);
 			break;
 		}
 
+		os_memset(&info, 0, sizeof(info));
 		info.id = elem->data[0];
 		if (!info.id) {
 			wpa_printf(MSG_ERROR, "%s: SCSID = 0 is invalid\n", __func__);
diff --git a/src/drivers/driver.h b/src/drivers/driver.h
index f77f708d9..a3f498c1b 100644
--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -76,6 +76,13 @@ enum hostapd_chan_width_attr {
 #define HOSTAPD_DFS_REGION_ETSI	2
 #define HOSTAPD_DFS_REGION_JP	3
 
+/* Mandatory fields of the QoS Characteristics element: EID Extension(1) +
+ * Control Info(4) + Minimum Service Interval(4) + Maximum Service Interval(4) +
+ * Minimum Data Rate(3) + Delay Bound(3)
+ */
+#define EID_EXT_QOS_CHAR_MIN_SIZE 19
+#define EID_EXT_QOS_CHAR_MAX_SIZE 44
+
 /**
  * struct hostapd_scs_desc_info - SCS Req information
  * @id: SCSID of each SCS stream
@@ -85,13 +92,12 @@ enum hostapd_chan_width_attr {
  * @qos_ie: QoS Characteristics IE in SCS Descriptor element
  * @qos_ie_len: the length of QoS Characteristics element
  */
-#define EID_EXT_QOS_CHAR_MAX_SIZE 44
 struct hostapd_scs_desc_info {
 	u8 id;
 	u8 req_type;
 	u8 dir;
 	u8 peer_addr[ETH_ALEN];
-	u8 qos_ie[EID_EXT_QOS_CHAR_MAX_SIZE];
+	u8 qos_ie[EID_EXT_QOS_CHAR_MAX_SIZE + 2];
 	u8 qos_ie_len;
 };
 
-- 
