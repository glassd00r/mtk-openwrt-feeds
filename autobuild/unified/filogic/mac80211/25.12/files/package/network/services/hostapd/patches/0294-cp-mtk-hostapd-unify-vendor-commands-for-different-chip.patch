 	dl = &muru->dl;
 	ul = &muru->ul;
 	comm = &muru->comm;
 
+	if (os_strcmp(config, "ul_user_cnt") == 0 ||
+	    os_strcmp(config, "dl_user_cnt") == 0) {
+		cnt = hostapd_parse_argument_helper(value, &val);
+		if (cnt != 1 || val[0] > 255)
+			goto para_fail;
