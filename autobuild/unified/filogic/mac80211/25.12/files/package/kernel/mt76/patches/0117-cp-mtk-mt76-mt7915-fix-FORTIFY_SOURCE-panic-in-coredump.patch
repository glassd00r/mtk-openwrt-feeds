From 45e6f64c8a9443674b88b0ce8b7a4f8fe010acb8 Mon Sep 17 00:00:00 2001
From: Rex Lu <rex.lu@mediatek.com>
Date: Fri, 18 Sep 2026 16:34:16 +0800
Subject: [PATCH] mtk: mt76: mt7915: fix FORTIFY_SOURCE panic in coredump
 fw_patch_date copy

strscpy() for dump->fw_patch_date was passed sizeof(dump->fw_patch_date)
(24, MT7915_BUILD_TIME_LEN) as the size limit, but the source buffer
patch_hdr->build_date is only 16 bytes (mt76_connac2_patch_hdr).
FORTIFY_SOURCE detects the count exceeds the source size and triggers
a BUG panic:

  Kernel BUG at __fortify_panic+0xc/0x10
  Internal error: Oops - BUG: 00000000f2000800 [#1] SMP

Fix by passing sizeof(mdev->patch_hdr->build_date) as the limit,
consistent with the wm_hdr and wa_hdr copies that follow.

Signed-off-by: Rex Lu <rex.lu@mediatek.com>
---
 mt7915/coredump.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mt7915/coredump.c b/mt7915/coredump.c
index 84f63d686..591125073 100644
--- a/mt7915/coredump.c
+++ b/mt7915/coredump.c
@@ -379,7 +379,7 @@ static struct mt7915_coredump *mt7915_coredump_build(struct mt7915_dev *dev, u8
 	strscpy(dump->fw_type, ((type == MT7915_RAM_TYPE_WA) ? "WA" : "WM"),
 		sizeof(dump->fw_type));
 	strscpy(dump->fw_patch_date, mdev->patch_hdr->build_date,
-		sizeof(dump->fw_patch_date));
+		sizeof(mdev->patch_hdr->build_date));
 	strscpy(dump->fw_ram_date[MT7915_RAM_TYPE_WM],
 		mdev->wm_hdr->build_date,
 		sizeof(mdev->wm_hdr->build_date));
-- 
2.45.2

