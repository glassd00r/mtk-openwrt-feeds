From 1370d26d7f141b6fc272a5eefcdbc8b2652c4529 Mon Sep 17 00:00:00 2001
From: Evelyn Tsai <evelyn.tsai@mediatek.com>
Date: Mon, 14 Sep 2026 14:22:29 +0800
Subject: [PATCH] mtk: mt76: mt7915: add WLAN ID bounds check in
 mt7915_mac_tx_free

Cherry-pick the out-of-bounds guard from mt7996_mac_tx_free to
mt7915_mac_tx_free. If the WLAN ID parsed from MT_TX_FREE_WLAN_ID
exceeds the WTBL size, log an error and bail out early to avoid
accessing an invalid WCID.

Signed-off-by: Evelyn Tsai <evelyn.tsai@mediatek.com>
Signed-off-by: Peter Chiu <chui-hao.chiu@mediatek.com>
---
 mt7915/mac.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/mt7915/mac.c b/mt7915/mac.c
index ee5f78146..81620e0e1 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -902,6 +902,12 @@ mt7915_mac_tx_free(struct mt7915_dev *dev, void *data, int len)
 			u16 idx;
 
 			idx = FIELD_GET(MT_TX_FREE_WLAN_ID, info);
+			if (idx >= mt7915_wtbl_size(dev)) {
+				dev_err(mdev->dev,
+					"invalid WLAN ID %u in tx_free\n",
+					idx);
+				return;
+			}
 			wcid = mt76_wcid_ptr(dev, idx);
 			sta = wcid_to_sta(wcid);
 			if (!sta)
-- 
2.45.2

